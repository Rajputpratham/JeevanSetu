# JeevanSetu — Environment Variables
#
# Copy to `.env.local` and fill in what you have. Everything is optional:
# without keys the app still runs, and it will TELL YOU what is missing instead
# of inventing numbers. Nothing here is required to boot or to pass tests.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Google Maps Platform — SERVER key (driving distance + ETA)
# ─────────────────────────────────────────────────────────────────────────────
# Used by lib/google-routes.ts → Routes API v2 (computeRoutes + computeRouteMatrix).
# Restrict it to "Routes API" only and to your server IPs; NEVER expose this key
# to the browser. Without it every distance/ETA is reported as "unavailable" and
# no number is displayed anywhere in the app.
GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 2. Google Maps Platform — BROWSER key (interactive map only)
# ─────────────────────────────────────────────────────────────────────────────
# Must be a DIFFERENT key from the one above. Restrict it by HTTP referrer
# (your domain + localhost) and to "Maps JavaScript API" only. It is embedded in
# the page by design, so it must not be able to spend money on Routes/Places.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 3. Google Places (optional) — hospital ratings & review snippets
# ─────────────────────────────────────────────────────────────────────────────
# Without it, ratings sections show the community score and say that Google
# ratings are unavailable. No rating is ever invented.
GOOGLE_PLACES_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 4. Google Gemini — the AI assistant's language layer
# ─────────────────────────────────────────────────────────────────────────────
# Without it the assistant still works: it answers from the deterministic rule
# engine and labels the reply as coming from that engine (groundingMode:
# 'deterministic-grounded'). Gemini only phrases answers — it never decides
# which hospitals to show, and it never sees an ungrounded number.
GEMINI_API_KEY=

# Text model used for normal replies.
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Optional model for the voice-token API. The current UI uses browser speech recognition.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# ─────────────────────────────────────────────────────────────────────────────
# 5. Site metadata (optional)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://jeevansetu.example
