# JeevanSetu — Optional External API Environment Variables
# All core features work out-of-the-box without keys using OpenStreetMap,
# JeevanSetu's Indian locality gazetteer, urban road/ETA modelling,
# IMDb-style Bayesian community scores, and deterministic grounded AI responses.

# Optional: Enables live Google Directions traffic ETA and Google Geocoding
GOOGLE_MAPS_API_KEY=

# Optional: Enables live Google Places hospital ratings & review snippets
GOOGLE_PLACES_API_KEY=

# Optional: Enables LLM-phrased multilingual responses strictly grounded in JeevanSetu data
OPENAI_API_KEY=
