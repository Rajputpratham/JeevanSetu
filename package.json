{
  "name": "jeevansetu",
  "version": "1.0.0",
  "private": true,
  "description": "JeevanSetu \u2014 Connecting people to better healthcare. Discover nearby hospitals, estimate treatment costs, compare facilities and get emergency assistance.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:browser": "node scripts/browser-qa.mjs",
    "qa:failures": "node scripts/browser-failures.mjs",
    "qa:history": "node scripts/browser-history.mjs",
    "qa": "npm run qa:browser && npm run qa:failures && npm run qa:history"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^5.1.0"
  }
}
